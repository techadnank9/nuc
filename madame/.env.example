# Copy this file to .env and fill it in. Never commit .env.

# LiveKit Cloud: cloud.livekit.io → your project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The robot station
ROBOT_HOST=pah@10.103.0.133
ROBOT_PASSWORD=
ROBOT_SECONDS=45

# 0 = dry run (arms do NOT move). 1 = arms move: only with someone on the e-stop.
ROBOT_LIVE=0
